{
  "name": "atelier-api",
  "private": true,
  "version": "1.0.0",
  "description": "REST API for the Atelier portfolio storefront (demo project).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
